{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "aspen",
    "name": "Warp",
    "colors": {
      "primary": "#9E1FAA",
      "light": "#9E1FAA",
      "dark": "#9E1FAA"
    },
    "favicon": "/favicon.png",
    "navigation": {
      "global": {
        "anchors": [
          {
            "anchor": "Home",
            "icon": "house",
            "href": "https://usewarp.net"
          },
          {
            "anchor": "Platform",
            "icon": "gauge-high",
            "href": "https://platform.usewarp.net"
          },
          {
            "anchor": "GitHub",
            "icon": "github",
            "href": "https://github.com/WarpCompany"
          }
        ]
      },
      "tabs": [
        {
          "tab": "Documentation",
          "groups": [
            {
              "group": "Getting Started",
              "pages": [
                "index",
                "quickstart",
                "products"
              ]
            },
            {
              "group": "Pay With Warp",
              "pages": [
                "warp-pay/index",
                "warp-pay/examples"
              ]
            },
            {
              "group": "Warp Bridge",
              "pages": [
                "warp-bridge/introduction",
                "warp-bridge/protocol",
                "warp-bridge/usecases"
              ]
            },
            {
              "group": "ZK Proofs as a Service",
              "pages": [
                "zkproofs/introduction"
              ]
            },
            {
              "group": "ZK Validator Network",
              "pages": [
                "zkvalidator/introduction"
              ]
            }
          ]
        },
        {
          "tab": "API Reference",
          "openapi": "openapi.json",
          "groups": [
            {
              "group": "Introduction",
              "openapi": "openapi.json"
            }
          ]
        }
      ]
    },
    "logo": {
      "light": "/logo/logoblack.png",
      "dark": "/logo/logowhite.png"
    },
    "navbar": {
      "links": [
        {
          "label": "Support",
          "href": "mailto:support@usewarp.net"
        }
      ],
      "primary": {
        "type": "button",
        "label": "Get Started",
        "href": "https://platform.usewarp.net"
      }
    },
    "contextual": {
      "options": [
       "copy",
       "view",
       "chatgpt",
       "claude",
       "perplexity",
       "mcp",
       "cursor",
       "vscode"
     ]
    },
    "footer": {
      "socials": {
        "github": "https://github.com/WarpCompany"
      }
    },
    "banner": {
      "content": "Payments API now live! Read more at API Reference",
      "dismissible": true
    },
    "styling": {
      "eyebrows": "section"
    },
    "api": {
      "playground": {
        "display": "interactive"
      }
    },
    "icons": {
      "library": "fontawesome"
    }
  }
