{
  "openapi": "3.0.3",
  "info": {
    "title": "Warp API",
    "version": "1.0.0",
    "description": "Public Warp API: hosted checkout sessions for Pay with Warp, hosted ZK proof verification, and Warp Verify attestation checks.",
    "contact": {
      "name": "Warp Support",
      "email": "support@usewarp.net"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.usewarp.net",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Checkout sessions",
      "description": "Create and track hosted checkout sessions."
    },
    {
      "name": "ZK verification",
      "description": "Verify Groth16 proofs against circuits deployed from the Warp Platform."
    },
    {
      "name": "Attestations",
      "description": "Public Warp Verify attestation checks."
    },
    {
      "name": "Health",
      "description": "Service status."
    }
  ],
  "paths": {
    "/v1/checkout/sessions": {
      "post": {
        "tags": [
          "Checkout sessions"
        ],
        "operationId": "createCheckoutSession",
        "summary": "Create a checkout session",
        "description": "Creates a hosted checkout session. Call this from your server with a secret key. The network (mainnet or testnet) is determined by the key: `sk_live_` keys create mainnet sessions, `sk_test_` keys create testnet sessions. Sessions expire 30 minutes after creation.",
        "x-mint": {
          "href": "/api-reference/checkout-sessions/create"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutSessionCreateRequest"
              },
              "example": {
                "amount_usd": 49.99,
                "description": "Order #1234",
                "metadata": {
                  "order_id": "1234"
                },
                "return_url": "https://example.com/orders/1234",
                "cancel_url": "https://example.com/cart"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "amount_usd: Number must be greater than 0"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid secret key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Checkout sessions"
        ],
        "operationId": "listCheckoutSessions",
        "summary": "List checkout sessions",
        "description": "Lists your project's checkout sessions. Use `starting_after` with the last `id` from the previous page to paginate.",
        "x-mint": {
          "href": "/api-reference/checkout-sessions/list"
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only return sessions with this status.",
            "schema": {
              "$ref": "#/components/schemas/CheckoutSessionStatus"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of sessions to return (1-100).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "required": false,
            "description": "Cursor for pagination: the `id` of the last session from the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSessionList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "amount_usd: Number must be greater than 0"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid secret key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/checkout/sessions/{id}": {
      "get": {
        "tags": [
          "Checkout sessions"
        ],
        "operationId": "retrieveCheckoutSession",
        "summary": "Retrieve a checkout session",
        "description": "Retrieves a session owned by your project. Includes `payment` once a payment transaction has been detected.",
        "x-mint": {
          "href": "/api-reference/checkout-sessions/retrieve"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Session ID (`ps_...`).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid secret key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by another project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Resource not found"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/zk/proofs/{proofId}/nonces": {
      "post": {
        "tags": [
          "ZK verification"
        ],
        "operationId": "createZkNonce",
        "summary": "Create a verification nonce",
        "description": "Issues a single-use nonce that expires after 10 minutes. Pass it to the verify endpoint to prevent replay of a verification request.",
        "x-mint": {
          "href": "/api-reference/zk-verification/create-nonce"
        },
        "parameters": [
          {
            "name": "proofId",
            "in": "path",
            "required": true,
            "description": "ZK proof ID from the Warp Platform.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Nonce created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZkNonce"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid secret key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by another project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Resource not found"
                  }
                }
              }
            }
          },
          "409": {
            "description": "The proof has no verification key yet (`proof_not_ready`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/zk/proofs/{proofId}/verify": {
      "post": {
        "tags": [
          "ZK verification"
        ],
        "operationId": "verifyZkProof",
        "summary": "Verify a proof",
        "description": "Verifies a Groth16 proof off-chain against the proof's stored verification key. With `onchain: true`, also calls `verifyProof` on the proof's deployed verifier contract (allow-listed chains only). Returns a signed receipt (compact JWS, EdDSA) that you can verify with the keys from the JWKS endpoint. Only the owning project's secret key can verify its proofs.",
        "x-mint": {
          "href": "/api-reference/zk-verification/verify-proof"
        },
        "parameters": [
          {
            "name": "proofId",
            "in": "path",
            "required": true,
            "description": "ZK proof ID from the Warp Platform.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZkVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZkVerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "amount_usd: Number must be greater than 0"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid secret key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by another project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Resource not found"
                  }
                }
              }
            }
          },
          "409": {
            "description": "The proof has no verification key yet (`proof_not_ready`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          },
          "502": {
            "description": "On-chain verification was requested but the chain RPC did not respond (`onchain_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/zk/proofs/{proofId}/interface": {
      "get": {
        "tags": [
          "ZK verification"
        ],
        "operationId": "getZkInterface",
        "summary": "Get the verifier interface",
        "description": "Returns the deployed verifier's address, chain, ABI and ready-made snippets (cURL, viem, cast, Solidity) for calling it.",
        "x-mint": {
          "href": "/api-reference/zk-verification/get-interface"
        },
        "parameters": [
          {
            "name": "proofId",
            "in": "path",
            "required": true,
            "description": "ZK proof ID from the Warp Platform.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verifier interface",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZkInterface"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid secret key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by another project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Resource not found"
                  }
                }
              }
            }
          },
          "409": {
            "description": "The proof has not been compiled or deployed yet (`proof_not_ready`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/.well-known/jwks.json": {
      "get": {
        "tags": [
          "ZK verification"
        ],
        "operationId": "getJwks",
        "summary": "Get receipt signing keys",
        "description": "Public JSON Web Key Set used to verify verification receipts. No authentication required.",
        "x-mint": {
          "href": "/api-reference/zk-verification/jwks"
        },
        "security": [],
        "responses": {
          "200": {
            "description": "JSON Web Key Set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jwks"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/attestations/{id}": {
      "get": {
        "tags": [
          "Attestations"
        ],
        "operationId": "getAttestation",
        "summary": "Check an attestation",
        "description": "Public check of a Warp Verify attestation. No authentication required; rate limited per IP. `valid` is `true` only when a real proof was recorded for the attestation.",
        "x-mint": {
          "href": "/api-reference/attestations/check"
        },
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Attestation ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attestation status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attestation"
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by another project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Resource not found"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns `200` when the API is up.",
        "x-mint": {
          "href": "/api-reference/health"
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests. Retry after the window resets."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your project secret key: `sk_test_...` (testnet) or `sk_live_...` (mainnet). Use it only on your server."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code: `invalid_request`, `unauthorized`, `not_found`, `proof_not_ready`, `onchain_unavailable`, `rate_limited` or `internal_error`.",
                "example": "invalid_request"
              },
              "message": {
                "type": "string",
                "description": "Human-readable description."
              }
            }
          }
        }
      },
      "CheckoutSessionStatus": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "completed",
          "failed",
          "expired"
        ],
        "description": "`pending`: waiting for payment. `processing`: a transaction was submitted and is being verified. `completed`: payment verified. `failed`: verification failed. `expired`: no payment within 30 minutes."
      },
      "CheckoutSessionCreateRequest": {
        "type": "object",
        "required": [
          "amount_usd"
        ],
        "properties": {
          "amount_usd": {
            "type": "number",
            "minimum": 0.01,
            "multipleOf": 0.01,
            "description": "Amount to charge in USD. Greater than 0, at most 2 decimal places.",
            "example": 49.99
          },
          "description": {
            "type": "string",
            "description": "Shown to the customer on the checkout page."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Your own key-value data, returned on the session and in webhooks."
          },
          "return_url": {
            "type": "string",
            "format": "uri",
            "description": "Where the \"Back to merchant\" button on the payment success page sends the customer."
          },
          "cancel_url": {
            "type": "string",
            "format": "uri",
            "description": "Where the \"Cancel and return\" link on the checkout page sends the customer."
          }
        }
      },
      "Payment": {
        "type": "object",
        "description": "The on-chain payment for a session.",
        "properties": {
          "chain": {
            "type": "string",
            "description": "Network the customer paid on.",
            "example": "base"
          },
          "token": {
            "type": "string",
            "description": "Token the customer paid with. You receive this token; there is no conversion.",
            "example": "USDC"
          },
          "tx_hash": {
            "type": "string",
            "description": "Transaction hash (lowercase).",
            "example": "0x5f2c..."
          },
          "amount": {
            "type": "string",
            "description": "Token amount paid, as a decimal string.",
            "example": "49.99"
          },
          "confirmations": {
            "type": "integer",
            "description": "Block confirmations observed."
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CheckoutSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ps_8f14e45fceea167a5a36dedd4bea2543"
          },
          "object": {
            "type": "string",
            "enum": [
              "checkout.session"
            ]
          },
          "amount_usd": {
            "type": "string",
            "description": "Amount in USD as a decimal string.",
            "example": "49.99"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "status": {
            "$ref": "#/components/schemas/CheckoutSessionStatus"
          },
          "network": {
            "type": "string",
            "enum": [
              "mainnet",
              "testnet"
            ],
            "description": "Determined by the secret key used to create the session."
          },
          "return_url": {
            "type": "string",
            "nullable": true
          },
          "cancel_url": {
            "type": "string",
            "nullable": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "30 minutes after creation."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "checkout_url": {
            "type": "string",
            "format": "uri",
            "description": "Hosted checkout page to redirect the customer to.",
            "example": "https://checkout.usewarp.net/session/ps_8f14e45fceea167a5a36dedd4bea2543"
          },
          "payment": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Payment"
              }
            ],
            "nullable": true,
            "description": "Present on retrieve once a payment has been detected."
          }
        }
      },
      "CheckoutSessionList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckoutSession"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "ZkNonce": {
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "10 minutes after creation. Single use."
          }
        }
      },
      "Groth16Proof": {
        "type": "object",
        "required": [
          "pi_a",
          "pi_b",
          "pi_c"
        ],
        "description": "Proof object as produced by snarkjs `groth16.fullProve`.",
        "properties": {
          "pi_a": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pi_b": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "pi_c": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol": {
            "type": "string",
            "enum": [
              "groth16"
            ]
          },
          "curve": {
            "type": "string",
            "enum": [
              "bn128"
            ]
          }
        }
      },
      "ZkVerifyRequest": {
        "type": "object",
        "required": [
          "proof",
          "public_signals"
        ],
        "properties": {
          "proof": {
            "$ref": "#/components/schemas/Groth16Proof"
          },
          "public_signals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Public signals as decimal strings. The count must match the circuit and each value must be below the BN254 scalar field modulus."
          },
          "nonce": {
            "type": "string",
            "description": "Optional nonce from the create-nonce endpoint."
          },
          "onchain": {
            "type": "boolean",
            "default": false,
            "description": "Also call `verifyProof` on the deployed verifier contract."
          }
        }
      },
      "ZkVerifyResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "proof_id": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "offchain": {
                "type": "boolean"
              },
              "onchain": {
                "type": "object",
                "properties": {
                  "chain_id": {
                    "type": "integer"
                  },
                  "contract_address": {
                    "type": "string"
                  },
                  "result": {
                    "type": "boolean"
                  }
                }
              },
              "nonce": {
                "type": "string",
                "enum": [
                  "ok",
                  "missing",
                  "used",
                  "expired"
                ]
              },
              "policy": {
                "type": "string",
                "enum": [
                  "ok",
                  "mismatch",
                  "n/a"
                ]
              }
            }
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "receipt": {
            "type": "string",
            "description": "Compact JWS (EdDSA, Ed25519) over `{ proof_id, public_signals, valid, verified_at, chain_id? }`. Verify it with the JWKS endpoint."
          }
        }
      },
      "ZkInterface": {
        "type": "object",
        "properties": {
          "contract_address": {
            "type": "string"
          },
          "chain_id": {
            "type": "integer"
          },
          "network": {
            "type": "string"
          },
          "abi": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "public_signal_count": {
            "type": "integer"
          },
          "snippets": {
            "type": "object",
            "properties": {
              "curl": {
                "type": "string"
              },
              "viem": {
                "type": "string"
              },
              "cast": {
                "type": "string"
              },
              "solidity": {
                "type": "string"
              }
            }
          }
        }
      },
      "Jwks": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kty": {
                  "type": "string",
                  "example": "OKP"
                },
                "crv": {
                  "type": "string",
                  "example": "Ed25519"
                },
                "x": {
                  "type": "string"
                },
                "kid": {
                  "type": "string"
                },
                "alg": {
                  "type": "string",
                  "example": "EdDSA"
                },
                "use": {
                  "type": "string",
                  "example": "sig"
                }
              }
            }
          }
        }
      },
      "Attestation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Lifecycle status, for example `active`, `revoked` or `expired`."
          },
          "type": {
            "type": "string",
            "enum": [
              "ownership",
              "compliance",
              "provenance"
            ]
          },
          "valid": {
            "type": "boolean",
            "description": "`true` only when a real proof was recorded and the attestation is current."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "chain_id": {
            "type": "integer"
          },
          "registry_address": {
            "type": "string"
          }
        }
      }
    }
  }
}
